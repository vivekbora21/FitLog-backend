# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
# Comma-separated, e.g. localhost,127.0.0.1,192.168.0.176
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=UTC

# Database (PostgreSQL)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://fitlog_user@localhost:5433/fitlog_db

# CORS - set ALLOW_ALL to False in production and list origins (comma-separated)
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=1440
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# API
API_PAGE_SIZE=20
